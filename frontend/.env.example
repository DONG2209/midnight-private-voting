# Not read by the app yet — the sandbox mode (see src/main.ts) needs none of
# this. These are the variables you'll add when you wire real on-chain
# submission via @midnight-ntwrk/midnight-js-contracts; see README.md
# § "Going from sandbox to testnet".

# The network id to hint to the wallet connector, e.g. "testnet".
VITE_NETWORK_ID=testnet

# The address of your deployed Private Voting contract (from `npm run deploy`
# once you add a deploy script, or from whatever tool you used to deploy).
VITE_CONTRACT_ADDRESS=

# Midnight indexer (public data provider) and proof server URIs for the
# network above. See https://docs.midnight.network for current endpoints.
VITE_INDEXER_URI=
VITE_INDEXER_WS_URI=
VITE_PROOF_SERVER_URI=
